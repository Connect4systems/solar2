 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-orientation\" content=\"Portrait\"><meta name=\"pdfkit-page-size\" content=\"A4\"><link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n{% macro money(value) -%}{% set s = frappe.format_value(value or 0, {'fieldtype':'Currency','currency':'EGP'}) %}{% if s[-3:] == '.00' %}{{ s[:-3] }}{% elif s[-1:] == '0' and '.' in s %}{{ s[:-1] }}{% else %}{{ s }}{% endif %}{%- endmacro %}\n{% macro num(value) -%}{% set s = frappe.format_value(value or 0, {'fieldtype':'Float','precision':2}) %}{% if s[-3:] == '.00' %}{{ s[:-3] }}{% elif s[-1:] == '0' and '.' in s %}{{ s[:-1] }}{% else %}{{ s }}{% endif %}{%- endmacro %}\n{% set company_name = frappe.db.get_value('Company', doc.company, 'company_name') or doc.company %}\n{% if doc.statement_type == '\u0639\u0645\u064a\u0644' %}{% set target_label = '\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644' %}{% set target_name = doc.customer %}{% elif doc.statement_type == '\u0645\u0648\u0631\u062f' %}{% set target_label = '\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f' %}{% set target_name = doc.supplier %}{% elif doc.statement_type == '\u0645\u0648\u0638\u0641' %}{% set target_label = '\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641' %}{% set target_name = doc.employee %}{% else %}{% set target_label = '\u0627\u0633\u0645 \u0627\u0644\u062d\u0633\u0627\u0628' %}{% set target_name = doc.account %}{% endif %}\n<div class=\"statement-sheet\">\n  <div class=\"statement-content\">\n    <div class=\"program-letterhead\">{{ frappe.get_doc('Letter Head', '\u0633\u0648\u0644\u0627\u0631 \u0633\u064a\u062a\u064a').content | safe }}</div>\n\n    <div class=\"title-box\"><h1>{{ doc.statement_title or '\u0643\u0634\u0641 \u062d\u0633\u0627\u0628 \u062a\u0641\u0635\u064a\u0644\u064a' }}</h1></div>\n\n    <div class=\"meta-lines\">\n      <div><span>\u0646\u0648\u0639 \u0627\u0644\u0643\u0634\u0641</span><b>{{ doc.statement_type }}</b></div>\n      <div><span>{{ target_label }}</span><b>{{ target_name or '-' }}</b></div>\n      <div><span>\u0645\u0646 \u062a\u0627\u0631\u064a\u062e</span><b>{{ frappe.format(doc.from_date, {'fieldtype':'Date'}) }}</b></div>\n      <div><span>\u0625\u0644\u0649 \u062a\u0627\u0631\u064a\u062e</span><b>{{ frappe.format(doc.to_date, {'fieldtype':'Date'}) }}</b></div>\n      <div><span>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629</span><b>{{ frappe.format(doc.generated_on or frappe.utils.now_datetime(), {'fieldtype':'Datetime'}) }}</b></div>\n    </div>\n\n    <div class=\"opening-line\"><span>\u0627\u0644\u0631\u0635\u064a\u062f \u0642\u0628\u0644 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0641\u062a\u0631\u0629</span><b>{{ money(doc.opening_balance) }}</b></div>\n\n    <table class=\"statement-table\">\n      <thead>\n        <tr>\n          <th class=\"col-num\">\u0645</th>\n          <th class=\"col-date\">\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th>\n          <th class=\"col-description\">\u0627\u0644\u0628\u064a\u0627\u0646 \u0623\u0648 \u0627\u0644\u0635\u0646\u0641</th>\n          <th class=\"col-qty\">\u0627\u0644\u0643\u0645\u064a\u0629</th>\n          <th class=\"col-uom\">\u0627\u0644\u0648\u062d\u062f\u0629</th>\n          <th class=\"col-price\">\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</th>\n          <th class=\"col-money\">\u0627\u0644\u0645\u062f\u064a\u0646 / \u0627\u0644\u0635\u0627\u062f\u0631</th>\n          <th class=\"col-money\">\u0627\u0644\u062f\u0627\u0626\u0646 / \u0627\u0644\u0648\u0627\u0631\u062f</th>\n          <th class=\"col-balance\">\u0627\u0644\u0631\u0635\u064a\u062f</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% set ns = namespace(m=0, detail_balance=(doc.opening_balance or 0)) %}\n        {% for row in doc.rows %}\n          {% set row_date = row.posting_date or row.date %}\n          {% if row.row_type == '\u0625\u062c\u0645\u0627\u0644\u064a \u0645\u062c\u0645\u0648\u0639\u0629' %}\n          <tr class=\"group-total\">\n            <td colspan=\"6\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td>\n            <td>{{ money(row.debit) }}</td>\n            <td>{{ money(row.credit) }}</td>\n            <td>{{ money(ns.detail_balance) }}</td>\n          </tr>\n          {% elif row.row_type == '\u0641\u0627\u062a\u0648\u0631\u0629' %}\n          {% set ns.m = ns.m + 1 %}\n          <tr class=\"invoice-header\">\n            <td>{{ ns.m }}</td>\n            <td>{{ frappe.format(row_date, {'fieldtype':'Date'}) if row_date else '' }}</td>\n            <td colspan=\"4\"><b>{{ row.remarks or row.voucher_type or '\u0641\u0627\u062a\u0648\u0631\u0629' }}</b>{% if row.voucher_type or row.voucher_no %}<small>{{ row.voucher_type or '' }}{% if row.voucher_no %} \u2014 {{ row.voucher_no }}{% endif %}</small>{% endif %}</td>\n            <td></td>\n            <td></td>\n            <td class=\"balance-cell\"></td>\n          </tr>\n          {% elif row.row_type == '\u0628\u0646\u062f \u0641\u0627\u062a\u0648\u0631\u0629' %}\n          {% set item_amount = row.custom_item_amount or ((row.qty or 0) * (row.unit_price or 0)) %}\n          {% set is_purchase = row.voucher_type == 'Purchase Invoice' %}\n          {% set item_signed = (0 - item_amount) if is_purchase else item_amount %}\n          {% set item_display = (0 - item_signed) if item_signed < 0 else item_signed %}\n          {% set ns.detail_balance = ns.detail_balance + item_signed %}\n          <tr class=\"item-row\">\n            <td class=\"item-arrow\">\u21b3</td>\n            <td>{% if row_date %}{{ frappe.format(row_date, {'fieldtype':'Date'}) }}{% endif %}</td>\n            <td class=\"description-cell\"><b>{{ row.custom_item_name or row.remarks or '-' }}</b>{% if row.custom_item_description and row.custom_item_description != row.custom_item_name %}<small>{{ row.custom_item_description }}</small>{% endif %}</td>\n            <td>{{ num(row.qty) if row.qty else '' }}</td>\n            <td>{{ row.uom or '' }}</td>\n            <td class=\"money-cell\">{{ money(row.unit_price) if row.unit_price else '' }}</td>\n            {% if is_purchase %}<td></td><td>{{ money(item_display) }}</td>{% else %}<td>{{ money(item_display) }}</td><td></td>{% endif %}\n            <td class=\"money-cell balance-cell {% if ns.detail_balance < 0 %}negative{% endif %}\">{{ money(ns.detail_balance) }}</td>\n          </tr>\n          {% else %}\n          {% set ns.m = ns.m + 1 %}\n          {% set ns.detail_balance = ns.detail_balance + (row.debit or 0) - (row.credit or 0) %}\n          <tr class=\"movement-row\">\n            <td>{{ ns.m }}</td>\n            <td>{% if row_date %}{{ frappe.format(row_date, {'fieldtype':'Date'}) }}{% endif %}</td>\n            <td class=\"description-cell\"><b>{{ row.remarks or '-' }}</b>{% if row.voucher_type or row.voucher_no %}<small>{{ row.voucher_type or '' }}{% if row.voucher_no %} \u2014 {{ row.voucher_no }}{% endif %}</small>{% endif %}</td>\n            <td>{{ num(row.qty) if row.qty else '' }}</td><td>{{ row.uom or '' }}</td><td></td>\n            <td class=\"money-cell\">{{ money(row.debit) if row.debit else '' }}</td>\n            <td class=\"money-cell\">{{ money(row.credit) if row.credit else '' }}</td>\n            <td class=\"money-cell balance-cell {% if ns.detail_balance < 0 %}negative{% endif %}\">{{ money(ns.detail_balance) }}</td>\n          </tr>\n          {% endif %}\n        {% endfor %}\n      </tbody>\n    </table>\n\n    <div class=\"summary-title\">\u0645\u0644\u062e\u0635 \u0643\u0634\u0641 \u0627\u0644\u062d\u0633\u0627\u0628</div>\n    <div class=\"summary-bar\">\n      <div><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0648\u0627\u0631\u062f</span><b>{{ money(doc.total_credit) }}</b></div>\n      <div><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0635\u0627\u062f\u0631</span><b>{{ money(doc.total_debit) }}</b></div>\n      <div class=\"closing\"><span>\u0627\u0644\u0631\u0635\u064a\u062f</span><b class=\"{% if (doc.closing_balance or 0) < 0 %}negative{% endif %}\">{{ money(doc.closing_balance) }}</b><em>{{ doc.balance_status or '\u0645\u062a\u0632\u0646' }}</em></div>\n    </div>\n  </div>\n\n  <footer class=\"statement-footer\">\n    <div class=\"footer-panel\">\n      <div class=\"footer-contact-block\"><b>\u0627\u0644\u0647\u0627\u062a\u0641</b><span>01111753518 - 01280211281</span><a href=\"https://wa.me/201111753518\" target=\"_blank\"><img src=\"https://api.qrserver.com/v1/create-qr-code/?size=70x70&amp;data=https://wa.me/201111753518\" alt=\"WhatsApp QR\"></a></div>\n      <div class=\"footer-contact-block\"><b>\u0645\u0648\u0642\u0639\u0646\u0627 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a</b><a href=\"https://solarcity-eg.com\" target=\"_blank\">Solarcity-eg.com</a><a href=\"https://solarcity-eg.com\" target=\"_blank\"><img src=\"https://api.qrserver.com/v1/create-qr-code/?size=70x70&amp;data=https://solarcity-eg.com\" alt=\"Website QR\"></a></div>\n      <div class=\"footer-company\"><img src=\"/files/logo-solar-icon.png\" alt=\"Solar City\"><strong>{{ company_name }}</strong><span>\u0644\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0634\u0645\u0633\u064a\u0629 \u0648\u062d\u0644\u0648\u0644 \u0627\u0644\u0645\u064a\u0627\u0647 \u0648\u0637\u0644\u0645\u0628\u0627\u062a \u0627\u0644\u0622\u0628\u0627\u0631 \u0648\u0627\u0644\u0631\u064a</span></div>\n    </div>\n    <div class=\"footer-bottom\"><div id=\"footer-html\" class=\"visible-pdf page-number\">\u0635\u0641\u062d\u0629 <span class=\"page\"></span> \u0645\u0646 <span class=\"topage\"></span></div></div>\n  </footer>\n</div>\n\n<style>\n@page{size:A4 portrait;margin:5mm}*{box-sizing:border-box}html,body,.print-format{width:100%!important;max-width:none!important;min-width:0!important;margin:0!important;padding:0!important;background:#fff;orientation:Portrait;page-size:A4;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}body{